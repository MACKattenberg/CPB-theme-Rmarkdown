% ---------- ACHTERGRONDAFBEELDING NUMMERS TITEL EN EINDSLIDE (geclipte versies)-------------------------
% Links 7cm breed: toon linkerhelft van afbeelding op ware verhoudingen
\newcommand{\cpbnummersbgleft}[1]{%
  \begin{scope}
    \clip (current page.north west)
      rectangle ([xshift=#1]current page.south west);
    \node[anchor=north west, inner sep=0pt]
      at (current page.north west)
      {\includegraphics[height=\paperheight]{\cpbtitelafbeeldingpad}};
  \end{scope}%
}

% Rechts 8cm breed: toon rechterhelft van afbeelding op ware verhoudingen
\newcommand{\cpbnummersbgright}[1]{%
  \begin{scope}
    \clip ([xshift=-#1]current page.north east)
      rectangle (current page.south east);
    \node[anchor=north east, inner sep=0pt]
      at (current page.north east)
      {\includegraphics[height=\paperheight]{\cpbtitelafbeeldingpad}};
  \end{scope}%
}

% Links 7cm breed: toon linkerhelft van afbeelding op ware verhoudingen
% voor de middle slides
\newcommand{\cpbnummersbgleftmiddle}[1]{%  #1 = breedte
  \begin{scope}
    \clip (current page.north west) rectangle ([xshift=#1]current page.south west);
    \node[anchor=north west, inner sep=0pt]
      at (current page.north west)
      {\includegraphics[height=\paperheight]{Images/numbersbackground.png}};
  \end{scope}%
}


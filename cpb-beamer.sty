      % Magenta vlak rechts onder — één zigzag op 75% (=12cm)
      % Vlak loopt HORIZONTAAL naar rechterrand op dezelfde hoogte
      \fill[cpbMagenta]
        ([xshift=8cm, yshift=3.8cm]current page.south west)         % start links
        -- ([xshift=11.55cm, yshift=3.8cm]current page.south west)  % horizontaal
        -- ([xshift=11.90cm, yshift=4.3cm]current page.south west)  % piek
        -- ([xshift=12.40cm, yshift=3.3cm]current page.south west)  % dal
        -- ([xshift=12.75cm, yshift=3.8cm]current page.south west)  % terug
        -- ([yshift=3.8cm]current page.south east)                   % horizontaal naar rechterrand
        -- (current page.south east)                                 % rechtsonder
        -- ([xshift=8cm]current page.south west)                     % linksonder
        -- cycle;

      % "Centraal Planbureau" in magenta
      \node[anchor=west, text width=7cm, align=flush left]
        at ([xshift=0.8cm, yshift=0.3cm]current page.west)
        {{\fontsize{30}{36}\selectfont\bfseries\color{cpbMagenta}
          Centraal\\[12pt]Planbureau}};

      % URL
      \node[anchor=west, font=\normalsize, text=cpbMagenta]
        at ([xshift=0.8cm, yshift=-2.2cm]current page.west)

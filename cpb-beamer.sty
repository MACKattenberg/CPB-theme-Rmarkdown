% ============================================================================
% Navigation buttons
% ============================================================================

% Usage: \cpbbutton{destination}{text}{position}
% Positions: inline, bottom left, bottom right
\newcommand{\cpbbutton}[3]{%
    \ifstrequal{#3}{inline}{%
        \hyperlink{#1}{\beamerbutton{#2}}%
    }{%
        \ifstrequal{#3}{bottom left}{%
            \begin{tikzpicture}[remember picture, overlay]
                \node[anchor=south west, inner sep=0pt]
                    at ([xshift=0.5cm,yshift=0.7cm]current page.south west)
                    {\hyperlink{#1}{\beamerbutton{#2}}};
            \end{tikzpicture}%
        }{%
            \ifstrequal{#3}{bottom right}{%
                \begin{tikzpicture}[remember picture, overlay]
                    \node[anchor=south east, inner sep=0pt]
                        at ([xshift=-0.5cm,yshift=0.7cm]current page.south east)
                        {\hyperlink{#1}{\beamerbutton{#2}}};
                \end{tikzpicture}%
            }{%
                \PackageError{cpb}{Unknown button position '#3'}%
                    {Use inline, bottom left, or bottom right.}%
            }%
        }%
    }%
}


% ============================================================================
% Horizontal diagrams
% ============================================================================

% Internal counter
\newcount\cpbdiagramcount

% Usage:
% \cpbdiagram{blue or magenta}{number of boxes}{
%   \cpbdiagramitem{Title}{Text}{Footnote}
%   ...
% }

\newcommand{\cpbdiagram}[3]{%
  \begingroup
  \ifnum#2<1\relax
    \PackageError{cpb-beamer}
      {A diagram needs at least 1 box}
      {Choose a number from 1 to 4.}%
  \else
    \ifnum#2>4\relax
      \PackageError{cpb-beamer}
        {A diagram supports at most 4 boxes}
        {Choose a number from 1 to 4.}%
    \else
      % Colour scheme
      \ifstrequal{#1}{blue}{%
        \colorlet{cpbDiagramMain}{cpbDonkerblauw}%
        \colorlet{cpbDiagramLight}{cpbCijferblauw}%
      }{%
        \ifstrequal{#1}{magenta}{%
          \colorlet{cpbDiagramMain}{cpbMagenta}%
          \colorlet{cpbDiagramLight}{cpbMagenta!18!white}%
        }{%
          \PackageError{cpb-beamer}
            {Unknown diagram colour scheme '#1'}
            {Use blue or magenta.}%
          \colorlet{cpbDiagramMain}{cpbDonkerblauw}%
          \colorlet{cpbDiagramLight}{cpbCijferblauw}%
        }%
      }%

      % Dimensions, expressed in centimetres
      \pgfmathsetmacro{\cpbDiagramWidth}
        {(\linewidth-2pt)/1cm}%
      \def\cpbDiagramGap{0.45}%
      \pgfmathsetmacro{\cpbDiagramBoxWidth}
        {(\cpbDiagramWidth-(#2-1)*\cpbDiagramGap)/#2}%

      \cpbdiagramcount=0\relax

      \begin{tikzpicture}[x=1cm,y=1cm]
        #3

        % Check that the supplied number matches the content
        \ifnum\cpbdiagramcount=#2\relax
        \else
          \PackageError{cpb-beamer}
            {Diagram box count does not match}
            {Supply exactly #2 diagram items.}%
        \fi

        % Draw arrows after the boxes
        \ifnum#2>1\relax
          \foreach \i in {2,...,#2}{%
            \pgfmathtruncatemacro{\previous}{\i-1}%
            \draw[
              cpbDiagramMain,
              line width=3pt,
              -{Latex[length=3mm,width=4mm]}
            ]
              (cpb-box-\previous-east)
              -- (cpb-box-\i-west);
          }%
        \fi
      \end{tikzpicture}%
    \fi
  \fi
  \endgroup
}

\newcommand{\cpbdiagramitem}[3]{%
  \advance\cpbdiagramcount by 1\relax
  \edef\cpbDiagramIndex{\the\cpbdiagramcount}%

  \pgfmathsetmacro{\cpbDiagramX}{%
    (\cpbDiagramIndex-1)*
    (\cpbDiagramBoxWidth+\cpbDiagramGap)%
  }%

  \begin{scope}[shift={(\cpbDiagramX,0)}]
    % Rounded box with coloured header
    \begin{scope}
      \clip[rounded corners=7pt]
        (0,0) rectangle (\cpbDiagramBoxWidth,2.8);

      \fill[cpbDiagramLight]
        (0,0) rectangle (\cpbDiagramBoxWidth,2.8);

      \fill[cpbDiagramMain]
        (0,1.95) rectangle (\cpbDiagramBoxWidth,2.8);
    \end{scope}

    % Title
    \node[
      text=white,
      font=\small\bfseries,
      align=center,
      inner sep=0pt,
      text width={(\cpbDiagramBoxWidth-0.24)*1cm}
    ] at ({\cpbDiagramBoxWidth/2},2.375) {#1};

    % Main text
    \node[
      text=black,
      font=\small,
      align=center,
      inner sep=0pt,
      text width={(\cpbDiagramBoxWidth-0.30)*1cm}
    ] at ({\cpbDiagramBoxWidth/2},0.975) {#2};

    % Footnote outside the box
    \node[
      anchor=north,
      text=cpbDiagramMain,
      font=\scriptsize\itshape,
      align=center,
      inner sep=0pt,
      text width={\cpbDiagramBoxWidth*1cm}
    ] at ({\cpbDiagramBoxWidth/2},-0.15) {#3};

    % Arrow connection points
    \coordinate (cpb-box-\cpbDiagramIndex-west)
      at (0,1.15);
    \coordinate (cpb-box-\cpbDiagramIndex-east)
      at (\cpbDiagramBoxWidth,1.15);
  \end{scope}%
}



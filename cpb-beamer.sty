% ---------- TITELAFBEELDING (optioneel) --------------------------------------
% Standaard: numbersbackground.png met het magenta vlak.
% De gekozen foto wordt gebruikt op de titel- en eindslide.
% Gebruiker kan een afbeelding instellen met:
%   \cpbtitelafbeelding{mijnfoto.jpg}
% Resetten (terug naar placeholder) met:
%   \cpbtitelafbeelding{}
\newif\ifcpbheeftafbeelding
\cpbheeftafbeeldingfalse
\newcommand{\cpbtitelafbeeldingpad}{Images/cover_bg.png}
\newcommand{\cpbtitelafbeelding}[1]{%
  \if\relax\detokenize{#1}\relax
    \renewcommand{\cpbtitelafbeeldingpad}{Images/cover_bg.png}%
    \cpbheeftafbeeldingfalse
  \else
    \renewcommand{\cpbtitelafbeeldingpad}{#1}%
    \cpbheeftafbeeldingtrue
  \fi
}

% Helper: teken de gebruikersafbeelding als die is ingesteld
% De afbeelding wordt op hoogte geschaald (behoudt verhoudingen).
% De clip op 8cm breed snijdt te brede afbeeldingen symmetrisch af
% vanuit het midden.
\newcommand{\cpbtekentitelafbeelding}{%
	\ifcpbheeftafbeelding
	\begin{scope}
		\clip (current page.north west) rectangle
		([xshift=8cm]current page.south west);
		\node[anchor=center, inner sep=0pt]
		at ([xshift=4cm]current page.west)
		{\includegraphics[height=\paperheight]{\cpbtitelafbeeldingpad}};
	\end{scope}
	\fi
}

% ============================================================================
% ZIGZAG TEKENMACRO
% ============================================================================
% Eén zigzag: dal-piek (omlaag dan omhoog).
% #1 = x-positie van het midden van de zigzag (als xshift)
% #2 = y-positie van de basislijn (als yshift)
% #3 = halve breedte van de zigzag
% #4 = diepte van het dal (positief getal, wordt afgetrokken)
% #5 = hoogte van de piek (positief getal, wordt opgeteld)
%
% Gebruik: \cpbzigzag{8cm}{-1.05cm}{0.8cm}{0.65cm}{0.75cm}
%          tekent zigzag gecentreerd op x=8cm, lijn op y=-1.05cm

% ============================================================================
% HERBRUIKBARE ELEMENTEN
% ============================================================================

% Toplijn contentslides: zigzag op 50% (=8cm bij 16cm breed)
\newcommand{\cpbtoplijn}{
  \begin{tikzpicture}[remember picture, overlay]
    \draw[cpbMagenta, line width=2.2pt]
      ([yshift=-0.75cm]current page.north west)
      -- ([yshift=-0.75cm, xshift=7.6cm]current page.north west)
      -- ([yshift=-1.08cm, xshift=7.8cm]current page.north west)    % dal
      -- ([yshift=-0.45cm, xshift=8.2cm]current page.north west)    % piek
      -- ([yshift=-0.75cm, xshift=8.4cm]current page.north west)    % terug
      -- ([yshift=-0.75cm]current page.north east);
    \node[anchor=north west, font=\fontsize{13}{15}\selectfont\bfseries,
          text=cpbMagenta]
      at ([xshift=0.55cm, yshift=-0.1cm]current page.north west) {CPB};
  \end{tikzpicture}
}

% Footer
\newcommand{\cpbfooterlijn}{
  \begin{tikzpicture}[remember picture, overlay]
    \draw[cpbMagenta, line width=2.2pt]
      ([yshift=0.6cm]current page.south west)
      -- ([yshift=0.6cm]current page.south east);
    \node[anchor=south east, font=\fontsize{8}{10}\selectfont, text=cpbMagenta]
      at ([xshift=-0.55cm, yshift=0.05cm]current page.south east) {|\enspace\insertframenumber};
  \end{tikzpicture}
}

% ============================================================================
% TYPE 1: TITELSLIDE — zigzag op 25% (=4cm)
% ============================================================================
\newcommand{\cpbtitelframe}{
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture, overlay]
      % Linkerhelft: cijfermatrix-achtergrond (8cm breed, ware verhoudingen)
      \cpbnummersbgleft{8cm}

      % Optionele gebruikersafbeelding over de linkerhelft (boven de numbers,
	   % maar ONDER het rijkslogo — dat wordt later getekend)
	   \cpbtekentitelafbeelding

      % Magenta vlak linksonder — zigzag op 25% (=4cm), horizontaal daarna
      \fill[cpbMagenta]
        ([yshift=4.2cm]current page.south west)                     % start links
        -- ([xshift=3.55cm, yshift=4.2cm]current page.south west)   % horizontaal
        -- ([xshift=3.90cm, yshift=3.7cm]current page.south west)   % dal
        -- ([xshift=4.40cm, yshift=4.7cm]current page.south west)   % piek
        -- ([xshift=4.75cm, yshift=4.2cm]current page.south west)   % terug
        -- ([xshift=8cm, yshift=4.2cm]current page.south west)      % horizontaal naar rand
        -- ([xshift=8cm]current page.south west)                    % rechtsonder
        -- (current page.south west) -- cycle;

      % Rijkslogo flush tegen bovenkant (BOVEN de afbeelding)
      \node[anchor=north, inner sep=0pt]
        at (current page.north)
        {\includegraphics[height=1.8cm]{Images/rijkslogo.png}};

      % Tekst rechterhelft
      \node[anchor=north west, font=\fontsize{8.5}{11}\selectfont, text=cpbDonkergrijs]
        at ([xshift=8.8cm, yshift=-0.6cm]current page.north west)
        {Centraal Planbureau\enspace|\enspace Event type};

      % Titel
	  \node[anchor=north west, inner sep=0pt]
		at ([xshift=8.8cm, yshift=-1.5cm]current page.north west)
		{\parbox{7cm}{\raggedright\fontsize{20}{25}\selectfont\bfseries\color{cpbMagenta}\inserttitle}};

      % Auteur
      \node[anchor=south west, text width=7cm, align=flush left]
        at ([xshift=8.8cm, yshift=2.3cm]current page.south west)
        {{\normalsize\color{cpbMagenta}\insertauthor\par}};         

      % Datum
      \node[anchor=south west, text width=7cm, align=flush left]
        at ([xshift=8.8cm, yshift=1.5cm]current page.south west)
        {{\small\color{cpbMagenta}\insertdate}};

      % URL
      \node[anchor=south west, text width=7cm, align=flush left]
        at ([xshift=8.8cm, yshift=1.1cm]current page.south west)
        {{\small\color{cpbMagenta}www.cpb.nl\enspace|\enspace @CPBnl}};

      % Disclaimer
      \node[anchor=south west, text width=7cm, align=flush left]
        at ([xshift=8.8cm, yshift=0.2cm]current page.south west)
        {{\fontsize{5.3}{6}\selectfont\color{cpbDonkerpaars}
        \cpbdisclaimer\par}};        
        
    \end{tikzpicture}
  \end{frame}
}

